# Sanity Configuration
PUBLIC_SANITY_PROJECT_ID=your_project_id_here
# `production` only in Vercel's Production environment. Use `staging` locally and in Vercel's Preview environment,
# so new copy can be tried without touching the live site (see .agents/todo-release.md).
PUBLIC_SANITY_DATASET=production

# Sanity Write Token (Optional - only needed for running seed scripts)
# SANITY_WRITE_TOKEN=your_write_token_here
