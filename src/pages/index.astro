---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import Hero from '../components/Hero.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import WaveSeparator from '../components/WaveSeparator.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { getSiteData } from '../utils/sanity';

const { settings, projects } = await getSiteData();
const { hero, seo, about, contact, footer, socialLinks } = settings;
---

<Layout title={seo?.title} description={seo?.description}>
  
  <div class="max-w-5xl mx-auto px-6 pt-10">
    <div class="hero-animate-1">
      <Header socialLinks={socialLinks} />
    </div>
  
    <Hero 
      title={hero?.title!}
      subtitle={hero?.subtitle!}
      ctaLabel={hero?.ctaLabel!}
      cvUrl={about?.cvUrl}
      cvLabel={about?.cvLabel}
    />
  </div> 

  <WaveSeparator position="top" />

  <ProjectsSection projects={projects} />

  <WaveSeparator position="bottom" />

  <About title={about?.title!} text={about?.text!} cvUrl={about?.cvUrl} cvLabel={about?.cvLabel} />

  <WaveSeparator position="top" />

  <div class="w-full bg-wave-bg pb-10">
    <div class="max-w-5xl mx-auto px-6 pt-4">
      <ContactSection contact={contact as any} />
      <Footer footer={footer as any} />
    </div>
  </div>

</Layout>