---
// Dev-only gallery: icons plus the articulated scenes, each next to its original and as an overlay.
import Layout from '../layouts/Layout.astro';
import Doodle from '../components/Doodle.astro';
import HeroScene from '../components/scenes/HeroScene.astro';
import HeroFrames from '../components/scenes/HeroFrames.astro';
import framesRaw from '../components/scenes/hero-frames.svg?raw';
import ContactScene from '../components/scenes/ContactScene.astro';
import AboutScene from '../components/scenes/AboutScene.astro';
import { ICON_OPTIONS } from '../utils/icons';
import heroRaw from '../../public/hero-illustration.svg?raw';
import contactRaw from '../../public/contact-señalar.svg?raw';

if (!import.meta.env.DEV) return new Response(null, { status: 404 });
const scenes = [...ICON_OPTIONS.map((o) => o.value), 'notfound'] as const;
const pairs: { title: string; original: string; Comp: any; props: Record<string, string> }[] = [
  { title: 'Hero', original: '/hero-illustration.svg', Comp: HeroScene, props: {} },
  { title: 'Contacto (escritorio)', original: '/contact-señalar.svg', Comp: ContactScene, props: { variant: 'desktop' } },
  { title: 'Contacto (celular)', original: '/contact-apoyado.svg', Comp: ContactScene, props: { variant: 'mobile' } },
];

// Paper plane review (phase 1 of plan-avion-de-papel): raw SVGs, one per variant and piece.
const planeRaw = import.meta.glob('../components/planes/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const plane = (v: string, piece: string) => planeRaw[`../components/planes/${v}-${piece}.svg`];
const PIECES = ['plane', 'plane-pinned', 'sheet'] as const;
const FRAMES = ['plane', 'unfold-1', 'unfold-2', 'sheet', 'fold-1', 'fold-2'] as const;
const VARIANTS = [
  { id: 'a', name: 'A. Dardo limpio', note: 'Silueta clásica, pliegues finos, la más sobria.' },
  { id: 'b', name: 'B. A mano suelta', note: 'Más variación de grosor y vértices movidos, la más cercana al trazo de las escenas.' },
  { id: 'c', name: 'C. Angular y chico', note: 'Cuerpo corto con alas abiertas, lee mejor a 40 px.' },
];
// Crops of the real scenes through the viewBox, to compare stroke weight.
const crop = (raw: string, vb: string) =>
  raw.replace(/<svg([^>]*?)width="[^"]*"\s*height="[^"]*"\s*viewBox="[^"]*"/, `<svg$1 viewBox="${vb}"`);
const heroCrop = crop(heroRaw, '330 400 320 240');
const mailCrop = crop(contactRaw, '500 440 280 210');
// Character pilot (phase 2 of plan-personaje-por-capas): generated rig poses next to the current hero.
const charRaw = import.meta.glob('../components/character/hero-*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const pose = (name: string) => charRaw[`../components/character/hero-${name}.svg`] ?? '';
const POSES = ['typing', 'throw-windup', 'throw-release'] as const;
const zoom = (svg: string, vb: string) => svg.replace(/viewBox="[^"]*"/, `viewBox="${vb}"`);
const headBox = '250 90 260 200'; // head and hair, shown at about 300 %
const handBox = '120 330 280 220'; // hand on the keyboard
// Hero by frames: every drawing on its own, cropped around its piece.
const CROPS: Record<string, string> = { base: '270 280 2560 2520', 'arm-l': '450 1000 750 700', 'arm-r': '1100 430 1100 850', 'plane-in-hand': '1300 290 700 280', head: '740 300 640 800', eyes: '980 560 330 130' };
const heroFrames = [...framesRaw.matchAll(/<g data-piece="([^"]+)">([\s\S]*?)<\/g>\n/g)].flatMap(([, piece, body]) =>
  body.split('<g data-frame="').slice(1).map((c) => ({
    piece, name: c.slice(0, c.indexOf('"')),
    svg: `<svg viewBox="${CROPS[piece]}" class="w-full h-auto" fill="none"><g data-frame="${c.replace(' visibility="hidden"', '')}</svg>`,
  })));
const inkD = (svg: string) => svg.match(/fill="#531F1F" d="([^"]*)"/)?.[1] ?? '';
---

<Layout title="Dibujos">
  <div class="max-w-6xl mx-auto px-6 py-12 flex flex-col gap-16">
    <section data-review="Hero por fotogramas">
      <h2 class="text-2xl text-accent-brown mb-2">Hero por fotogramas: dibujos de Krita</h2>
      <p class="mb-6 text-sm">Izquierda, el hero actual; derecha, los 12 PNG vectorizados (<code>scripts/illustrations/hero-frames/trace.mjs</code>) con el grosor del trazo original y las formas cerradas rellenas con el color de fondo. Mismo tamaño. Los botones corren la animación a 10 fotogramas por segundo.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-6" data-frames-demo>
        <figure><img src="/hero-illustration.svg" alt="Hero actual" class="w-full" /><figcaption class="text-xs">Actual</figcaption></figure>
        <figure>
          <HeroFrames scene="hero-demo" class="w-full h-auto block overflow-visible" />
          <figcaption class="text-xs">Fotogramas</figcaption>
        </figure>
      </div>
      <div class="flex flex-wrap gap-3 mb-10 text-sm">
        <button type="button" data-hf="idle" class="px-4 py-2 rounded-full border border-accent-brown/40 text-accent-brown">Idle: tipea y parpadea</button>
        <button type="button" data-hf="throw" class="px-4 py-2 rounded-full border border-accent-brown/40 text-accent-brown">Lanzamiento</button>
        <button type="button" data-hf="rest" class="px-4 py-2 rounded-full border border-accent-brown/40 text-accent-brown">Reposo (reduced motion)</button>
        <span data-hf="status" class="self-center text-xs opacity-70"></span>
      </div>
      <h3 class="text-xl text-accent-brown mb-3">Ampliado 300 %: cabeza</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
        <figure><div class="w-full" set:html={zoom(heroRaw.replace(/width="[^"]*"\s*height="[^"]*"/, ''), headBox)} /><figcaption class="text-xs">Actual</figcaption></figure>
        <figure><HeroFrames scene="hero-zoom" box="790 300 560 440" class="w-full h-auto block" /><figcaption class="text-xs">Krita vectorizado</figcaption></figure>
      </div>
      <h3 class="text-xl text-accent-brown mb-3">Todos los fotogramas</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" data-hf-gallery>
        {heroFrames.map((f) => <figure class="bg-main-bg border border-accent-brown/15 rounded p-2"><div set:html={f.svg} /><figcaption class="text-xs mt-1">{f.piece} / {f.name}</figcaption></figure>)}
      </div>
    </section>
    <section data-review="Personaje piloto">
      <h2 class="text-2xl text-accent-brown mb-2">Personaje por capas: piloto del hero</h2>
      <p class="mb-6 text-sm">Izquierda, el hero actual; derecha, el rig por capas (<code>scripts/illustrations/character/</code>) en las tres poses: usa el trazo exacto del original, recortado en piezas articuladas, y solo dibuja lo que el original no tenía. Mismo tamaño. Abajo, la cabeza y la mano ampliadas al 300 % para comparar el trazo.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10" data-pilot="same-size">
        <figure><img src="/hero-illustration.svg" alt="Hero actual" class="w-full" /><figcaption class="text-xs">Actual</figcaption></figure>
        {POSES.map((n) => <figure><div class="w-full" set:html={pose(n)} /><figcaption class="text-xs">{n}</figcaption></figure>)}
      </div>
      <h3 class="text-xl text-accent-brown mb-3">Ampliado 300 %</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" data-pilot="zoom">
        <figure><div class="w-full" set:html={zoom(heroRaw.replace(/width="[^"]*"\s*height="[^"]*"/, ''), headBox)} /><figcaption class="text-xs">Actual: cabeza</figcaption></figure>
        <figure><div class="w-full" set:html={zoom(pose('typing'), headBox)} /><figcaption class="text-xs">Piloto: cabeza</figcaption></figure>
        <figure><div class="w-full" set:html={zoom(heroRaw.replace(/width="[^"]*"\s*height="[^"]*"/, ''), handBox)} /><figcaption class="text-xs">Actual: brazo y mano</figcaption></figure>
        <figure><div class="w-full" set:html={zoom(pose('typing'), handBox)} /><figcaption class="text-xs">Piloto: brazo y mano</figcaption></figure>
      </div>
    </section>
    <section data-review="Avión de papel">
      <h2 class="text-2xl text-accent-brown mb-2">Avión de papel: 3 variantes</h2>
      <p class="mb-6 text-sm">Cada columna: tamaño real (52 px) y ampliado, el desdoble en 6 fotogramas y recortes de las escenas a escala parecida para comparar el trazo.</p>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {VARIANTS.map((v) => (
          <article class="plane-col flex flex-col gap-5" data-variant={v.id}>
            <header><h3 class="text-xl text-accent-brown">{v.name}</h3><p class="text-sm">{v.note}</p></header>
            <div class="grid grid-cols-3 gap-3 items-end">
              {PIECES.map((p) => (
                <figure><div class="w-full" set:html={plane(v.id, p)} /><figcaption class="text-xs">{p}</figcaption></figure>
              ))}
            </div>
            <div class="flex items-end gap-4">
              {PIECES.map((p) => <div class="w-[52px]" set:html={plane(v.id, p)} />)}
              <div class="w-[52px]" set:html={plane(v.id, 'fold-2')} />
              <span class="text-xs">tamaño real</span>
            </div>
            <div class="grid grid-cols-6 gap-1">
              {FRAMES.map((f) => <figure><div set:html={plane(v.id, f)} /><figcaption class="text-[10px]">{f}</figcaption></figure>)}
            </div>
            <div class="flex items-center gap-3">
              <div class="w-32 plane-stage" data-frames={JSON.stringify(FRAMES.map((f) => f))}>
                {FRAMES.map((f, i) => <div class="plane-frame" data-i={i} style={i ? 'display:none' : ''} set:html={plane(v.id, f)} />)}
              </div>
              <button class="text-xs underline" data-play="stop">Stop-motion</button>
              <svg class="w-32 morph-svg" viewBox="0 0 124 72" fill="none" data-morph={JSON.stringify([inkD(plane(v.id, 'plane')), inkD(plane(v.id, 'sheet')), inkD(plane(v.id, 'fold-2'))])}>
                <path fill="#531F1F" d={inkD(plane(v.id, 'plane'))} />
              </svg>
              <button class="text-xs underline" data-play="morph">Morph</button>
            </div>
          </article>
        ))}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8 max-w-3xl">
        <figure><div class="w-full max-w-[420px] crop" set:html={heroCrop} /><figcaption class="text-xs">Hero (laptop), ampliado x3</figcaption></figure>
        <figure><div class="w-full max-w-[420px] crop" set:html={mailCrop} /><figcaption class="text-xs">Buzón (ranura y sobre), ampliado x3.4</figcaption></figure>
        <figure class="sm:col-span-2 flex items-end gap-6">
          <div class="w-[132px] crop" set:html={heroCrop} />
          <div class="w-[122px] crop" set:html={mailCrop} />
          <figcaption class="text-xs">Mismos recortes a escala real del sitio (hero 420 px de ancho): compará con los aviones de "tamaño real".</figcaption>
        </figure>
      </div>
    </section>
    {pairs.map(({ title, original, Comp, props }) => (
      <section data-review={title}>
        <h2 class="text-2xl text-accent-brown mb-4">{title}</h2>
        <div class="grid grid-cols-3 gap-6 items-end">
          <figure><img src={original} alt="" class="w-full" /><figcaption>Original</figcaption></figure>
          <figure><Comp {...props} class="w-full h-auto" /><figcaption>Nuevo</figcaption></figure>
          <figure class="relative">
            <img src={original} alt="" class="w-full opacity-30" />
            <div class="absolute inset-0 review-overlay"><Comp {...props} class="w-full h-auto" /></div>
            <figcaption>Superposición</figcaption>
          </figure>
        </div>
      </section>
    ))}
    <section data-review="Sobre mí">
      <h2 class="text-2xl text-accent-brown mb-4">Sobre mí</h2>
      <div class="max-w-xl"><AboutScene class="w-full h-auto" /></div>
    </section>
    <section data-review="Articulaciones">
      <h2 class="text-2xl text-accent-brown mb-4">Ángulo máximo de cada articulación</h2>
      <div class="grid grid-cols-3 gap-6 items-end review-max">
        <HeroScene class="w-full h-auto" />
        <ContactScene variant="desktop" class="w-full h-auto" />
        <ContactScene variant="mobile" class="w-full h-auto" />
      </div>
    </section>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
      {scenes.map((scene) => (
        <figure class="fade-up flex flex-col items-center gap-3">
          <Doodle name={scene} class="w-full h-auto" />
          <figcaption class="text-lg text-accent-brown">{scene}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</Layout>


<style is:global>
  .plane-col div > svg:not(.morph-svg), .crop svg { width: 100%; height: auto; display: block; }
  .plane-col .morph-svg { width: 8rem; height: auto; }
  .review-overlay [data-part] path:not([fill]), .review-overlay [data-part] ellipse { stroke: #1f6feb; }
  .review-overlay [data-part] [fill="#531F1F"] { fill: #1f6feb; }
</style>

<script>
  import { createHeroRig } from '../scripts/motion/hero-frames';
  const demo = document.querySelector<SVGSVGElement>('[data-scene="hero-demo"]');
  if (demo) {
    const rig = createHeroRig(demo);
    rig.rest();
    const typing = rig.typing(), blink = rig.blink();
    let throwing: gsap.core.Timeline | null = null;
    const status = document.querySelector<HTMLElement>('[data-hf="status"]')!;
    const stop = () => { typing.pause(); blink.pause(); throwing?.kill(); throwing = null; rig.rest(); status.textContent = ''; };
    document.querySelector('[data-hf="idle"]')!.addEventListener('click', () => { stop(); typing.play(); blink.play(); });
    document.querySelector('[data-hf="rest"]')!.addEventListener('click', stop);
    document.querySelector('[data-hf="throw"]')!.addEventListener('click', () => {
      stop();
      throwing = rig.throwIt(() => (status.textContent = 'avión suelto (aquí arranca flight.ts)'), () => { status.textContent = ''; typing.play(); blink.play(); });
    });
  }
  import { gsap } from 'gsap';
  import { MorphSVGPlugin } from 'gsap/MorphSVGPlugin';
  gsap.registerPlugin(MorphSVGPlugin);
  document.querySelectorAll<HTMLElement>('.plane-col').forEach((col) => {
    const frames = [...col.querySelectorAll<HTMLElement>('.plane-frame')];
    col.querySelector('[data-play="stop"]')?.addEventListener('click', () => {
      frames.forEach((f, i) => (f.style.display = i ? 'none' : ''));
      let i = 0;
      const id = setInterval(() => {
        frames[i].style.display = 'none';
        if (++i >= frames.length) return clearInterval(id), (frames[0].style.display = '');
        frames[i].style.display = '';
      }, 160);
    });
    const svg = col.querySelector<SVGSVGElement>('.morph-svg')!;
    const ds: string[] = JSON.parse(svg.dataset.morph!);
    col.querySelector('[data-play="morph"]')?.addEventListener('click', () => {
      const path = svg.querySelector('path')!;
      gsap.timeline().set(path, { attr: { d: ds[0] } }).to(path, { morphSVG: ds[1], duration: 0.4, ease: 'power2.inOut' }).to(path, { morphSVG: ds[2], duration: 0.4, ease: 'power2.inOut' });
    });
  });
  // Pose every articulated part at its maximum planned angle to inspect the joints.
  const MAX: Record<string, string> = { head: '3', forearm: '-5', handBack: '-4', handFront: '4', hand: '-6', slotLid: '-25' };
  document.querySelectorAll<SVGGElement>('.review-max [data-part]').forEach((g) => {
    const angle = MAX[g.dataset.part ?? ''];
    if (!angle || !g.dataset.origin) return;
    const [x, y] = g.dataset.origin.split(' ');
    g.setAttribute('transform', `rotate(${angle} ${x} ${y})`);
  });
</script>
