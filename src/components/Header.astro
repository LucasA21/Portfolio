---
import { Icon } from "astro-icon/components";

interface SocialLink {
  _key: string;
  platform: string;
  url: string;
}

interface Props {
  socialLinks?: SocialLink[];
}

const { socialLinks = [] } = Astro.props;

// Mapeo de plataforma a ícono de astro-icon
const iconMap: Record<string, string> = {
  linkedin: 'simple-icons:linkedin',
  github: 'simple-icons:github',
  instagram: 'simple-icons:instagram',
  gmail: 'simple-icons:gmail',
  twitter: 'simple-icons:x',
};
---

<header
  class="flex justify-center md:justify-between items-center bg-glass-card backdrop-blur-md border border-stroke rounded-full px-6 md:px-10 py-1.5 md:grid md:grid-cols-[1fr_auto_1fr]"
>
  <div class="header-name hidden md:flex flex-row items-center gap-2 leading-none tracking-wider text-2xl font-medium text-accent-brown cursor-default">
    <span>Lucas</span>
    <span>Araya</span>
  </div>

  <nav aria-label="Secciones" class="hidden md:flex gap-8 items-center justify-self-center text-base tracking-wider">
    <a href="#about" class="nav-link">Sobre mí</a>
    <a href="#projects" class="nav-link">Proyectos</a>
    <a href="#contact" class="nav-link">Contacto</a>
  </nav>

  <nav aria-label="Redes" class="flex gap-0 sm:gap-2 items-center justify-self-end">
    {socialLinks.map((social) => (
      <a
        href={social.url}
        target={social.url.startsWith('mailto:') ? undefined : '_blank'}
        rel={social.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
        class="inline-flex items-center justify-center size-11 text-accent-brown hover:-translate-y-1 hover:opacity-70 transition-all"
        aria-label={social.platform}
      >
        <Icon name={iconMap[social.platform] ?? 'lucide:link'} size={20} />
      </a>
    ))}
  </nav>
</header>

<style>
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text-dark);
    transition: color 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.5rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent-brown);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current="true"] {
    color: var(--color-accent-brown);
  }
  .nav-link:hover {
    transform: translateY(-1px);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[aria-current="true"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .header-name {
    transition: transform 0.3s ease;
  }
</style>

<script>
  // Marks the nav link of the section in view.
  function setupNavSpy() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav-link')];
    const targets = links.map((l) => document.querySelector(l.getAttribute('href')!));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((l, i) => {
            if (targets[i] === e.target) l.setAttribute('aria-current', 'true');
            else l.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );
    targets.forEach((t) => t && io.observe(t));
  }
  setupNavSpy();
  document.addEventListener('astro:after-swap', setupNavSpy);
</script>
