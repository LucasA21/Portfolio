---
import ProjectCard from './ProjectCard.astro';
import FeaturedProject from './FeaturedProject.astro';
import type { Project } from '../utils/sanity';
import ProjectModal from './ProjectModal.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
// One featured card on top; the rest go in the grid. TheJudex is the fallback while nothing is flagged in Sanity.
const featured = projects.find((p) => p.featured) ?? projects.find((p) => p.title.toLowerCase() === 'thejudex');
const rest = projects.filter((p) => p !== featured);
---

<div class="w-full bg-wave-bg pt-12 pb-20 min-h-[400px]">
  <section id="projects" class="max-w-5xl mx-auto px-6 scroll-mt-[22vh] relative z-10">
    <div class="flex flex-col md:flex-row md:items-baseline md:justify-start md:gap-6 gap-1 mb-10 text-center md:text-left">
      <h2 class="text-3xl md:text-4xl font-medium tracking-wider text-accent-brown">Proyectos</h2>
      <p class="font-hand text-accent-warm text-xl md:-rotate-1">en producción y proyectos propios</p>
    </div>

    {featured && <FeaturedProject project={featured} />}

    <div id="projects-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-14 stagger-group">
      {rest.map((project) => (
        <ProjectCard
          id={project._id}
          title={project.title}
          description={project.description}
          content={project.content}
          tags={project.tags ?? []}
          icon={project.icon}
          link={project.link}
          mainImage={project.mainImage}
          gallery={project.gallery}
          screenshot={project.screenshot}
          screenshotAlt={project.screenshotAlt}
        />
      ))}
    </div>

    <div id="projects-more-wrap" class="mt-12 hidden justify-center">
      <button
        type="button"
        id="projects-more"
        aria-expanded="false"
        aria-controls="projects-container"
        class="inline-flex items-center gap-3 bg-main-bg border border-accent-brown/55 px-8 py-3.5 rounded-full text-base font-medium text-accent-brown hover:shadow-lg active:scale-95 transition-all duration-300 cursor-pointer"
      >
        <span id="projects-more-label">Ver más proyectos</span>
        <svg id="projects-more-arrow" class="w-4 h-4 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
      </button>
    </div>
  </section>
</div>

<ProjectModal />

<script>
  function setupProjects() {
    // "Ver más": up to 6 cards on desktop (>= 1024px), 4 cards on mobile/tablet.
    const grid = document.getElementById('projects-container');
    const moreWrap = document.getElementById('projects-more-wrap');
    const moreBtn = document.getElementById('projects-more');
    if (grid && moreWrap && moreBtn) {
      const cards = [...grid.querySelectorAll<HTMLElement>('.project-card')];
      let expanded = false;
      const limit = () => (matchMedia('(min-width: 1024px)').matches ? 6 : 4);
      const label = document.getElementById('projects-more-label')!;
      const arrow = document.getElementById('projects-more-arrow')!;
      const apply = () => {
        const base = limit(), n = cards.length - base === 1 ? cards.length : base;
        cards.forEach((c, i) => {
          const show = expanded || i < n;
          c.classList.toggle('hidden', !show);
          if (show) c.classList.add('is-visible');
        });
        const extra = cards.length - n;
        moreWrap.classList.toggle('hidden', extra <= 0);
        moreWrap.classList.toggle('flex', extra > 0);
        label.textContent = expanded ? 'Ver menos' : `Ver más proyectos (${Math.max(extra, 0)})`;
        arrow.style.transform = expanded ? 'rotate(180deg)' : '';
        moreBtn.setAttribute('aria-expanded', String(expanded));
      };
      moreBtn.addEventListener('click', () => {
        expanded = !expanded;
        apply();
        if (!expanded) {
          const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
          document.getElementById('projects')?.scrollIntoView({ behavior });
        }
      });
      matchMedia('(min-width: 768px)').addEventListener('change', apply);
      matchMedia('(min-width: 1024px)').addEventListener('change', apply);
      apply();
    }

    // Lógica de Swipe para Mobile
    function addSwipeSupport(el: HTMLElement, onLeft: () => void, onRight: () => void) {
      let startX = 0;
      let startY = 0;
      el.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
      }, { passive: true });
      el.addEventListener('touchend', (e) => {
        const endX = e.changedTouches[0].clientX;
        const endY = e.changedTouches[0].clientY;
        const diffX = startX - endX;
        const diffY = startY - endY;
        if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
          if (diffX > 0) onLeft();
          else onRight();
        }
      }, { passive: true });
    }

    // Lógica del Modal Rediseñado (Vertical + Carrusel)
    const modal = document.getElementById('project-modal') as HTMLDialogElement;
    const closeBtn = document.getElementById('close-modal');
    const cards = document.querySelectorAll('.project-card, .project-featured');
    const modalImgContainer = document.getElementById('modal-image-container');

    if (!modal || !closeBtn) return;

    let currentImgIndex = 0;
    let modalImages: string[] = [];
    let autoplayTimer: any = null;

    // Lightbox Elements
    const lightbox = document.getElementById('project-lightbox') as HTMLDialogElement;
    const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxCounter = document.getElementById('lightbox-counter');

    function startAutoplay() {
        stopAutoplay();
        if (modalImages.length <= 1 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        autoplayTimer = setInterval(() => {
            let next = (currentImgIndex + 1) % modalImages.length;
            updateModalImage(next);
        }, 3000);
    }

    function stopAutoplay() {
        if (autoplayTimer) {
            clearInterval(autoplayTimer);
            autoplayTimer = null;
        }
    }

    function updateLightboxImage(index: number) {
        currentImgIndex = index;
        if (lightboxImg && modalImages[index]) {
            lightboxImg.src = modalImages[index];
            if (lightboxCounter) {
                lightboxCounter.textContent = `${index + 1} / ${modalImages.length}`;
                lightboxCounter.classList.toggle('hidden', modalImages.length <= 1);
            }
        }
        updateModalImage(index); // Sync modal carousel
    }

    function openLightbox() {
        if (modalImages.length === 0) return;
        updateLightboxImage(currentImgIndex);
        lightbox.showModal();
        stopAutoplay();
    }

    if (modalImgContainer) {
      // Click and keydown to open Lightbox
      modalImgContainer.addEventListener('click', openLightbox);
      modalImgContainer.addEventListener('keydown', (e) => {
        if (e.target !== modalImgContainer) return;
        if (e.key === ' ' || e.key === 'Enter') {
          // Stops the keypress from landing on the lightbox close button, which takes focus on open
          e.preventDefault();
          openLightbox();
        }
      });

      addSwipeSupport(
        modalImgContainer,
        () => {
          if (modalImages.length <= 1) return;
          let next = (currentImgIndex + 1) % modalImages.length;
          updateModalImage(next);
          startAutoplay(); // Reset timer on manual interaction
        },
        () => {
          if (modalImages.length <= 1) return;
          let prev = (currentImgIndex - 1 + modalImages.length) % modalImages.length;
          updateModalImage(prev);
          startAutoplay(); // Reset timer on manual interaction
        }
      );
    }

    function preloadImages(urls: string[]) {
        urls.forEach(url => {
            const img = new Image();
            img.src = url;
        });
    }

    function updateModalImage(index: number) {
        const mainImgEl = document.getElementById('modal-main-image') as HTMLImageElement;
        const dots = document.querySelectorAll('.modal-dot');
        
        if (mainImgEl && modalImages[index]) {
            mainImgEl.style.opacity = '0';
            mainImgEl.style.transform = 'scale(1.02)';
            
            setTimeout(() => {
                mainImgEl.src = modalImages[index];
                mainImgEl.style.opacity = '1';
                mainImgEl.style.transform = 'scale(1)';
            }, 300);
        }

        dots.forEach((dot, i) => {
            const pill = dot.querySelector('.modal-dot-pill');
            if (!pill) return;
            if (i === index) {
                pill.classList.add('bg-accent-brown', 'w-6');
                pill.classList.remove('bg-accent-brown/35', 'w-2');
            } else {
                pill.classList.remove('bg-accent-brown', 'w-6');
                pill.classList.add('bg-accent-brown/35', 'w-2');
            }
        });
        currentImgIndex = index;
    }

    cards.forEach(card => {
        card.addEventListener('click', (e) => {
            if ((e.target as Element).closest('a')) return; // "Ver sitio" navigates, it does not open the modal
            const data = JSON.parse(card.getAttribute('data-project') || '{}');
            const gallery = Array.isArray(data.gallery) ? data.gallery.filter(Boolean) : [];
            const fallbackShot = data.mainImage || data.screenshot;
            modalImages = fallbackShot ? [fallbackShot, ...gallery.filter((g: string) => g !== fallbackShot)] : gallery;
            currentImgIndex = 0;

            const carouselWrap = document.getElementById('modal-carousel-wrap');
            const detailsScroll = document.getElementById('modal-details-scroll');
            if (carouselWrap) carouselWrap.classList.toggle('hidden', modalImages.length === 0);

            // Preload gallery images
            preloadImages(modalImages);
            
            // Inyectar texto
            const titleEl = document.getElementById('modal-title');
            const leadEl = document.getElementById('modal-lead');
            const descEl = document.getElementById('modal-description');
            const tagsEl = document.getElementById('modal-tags');
            const linkEl = document.getElementById('modal-link') as HTMLAnchorElement;
            const linkWrap = document.getElementById('modal-link-wrap');
            const dotsContainer = document.getElementById('modal-dots-container');
            const lightboxControls = document.getElementById('lightbox-controls');
            const lightboxPrev = document.getElementById('lightbox-prev');
            const lightboxNext = document.getElementById('lightbox-next');
            const lightboxSwipeHint = document.getElementById('lightbox-swipe-hint');

            if (titleEl) titleEl.textContent = data.title;
            if (leadEl) {
                const showLead = Boolean(data.description && data.contentHtml && data.contentHtml !== data.description);
                leadEl.textContent = showLead ? data.description : '';
                leadEl.classList.toggle('hidden', !showLead);
            }
            if (descEl) descEl.textContent = ""; // Clear existing
            if (descEl) descEl.innerHTML = data.contentHtml || data.description;
            
            const hasLiveLink = Boolean(data.link && /^https?:\/\//i.test(data.link));
            if (linkEl && linkWrap) {
                if (hasLiveLink) {
                    linkEl.href = data.link;
                    linkWrap.classList.remove('hidden');
                } else {
                    linkEl.removeAttribute('href');
                    linkWrap.classList.add('hidden');
                }
            }
            if (detailsScroll) {
                detailsScroll.classList.toggle('pb-28', hasLiveLink);
                detailsScroll.classList.toggle('pb-10', !hasLiveLink);
            }

            if (tagsEl) {
                tagsEl.innerHTML = (data.tags || []).map((tag: string) => `
                    <span class="text-xs px-3 py-1 rounded-full border border-accent-brown/25 bg-wave-bg/70 text-accent-brown/90 tracking-wide font-medium">
                        ${tag}
                    </span>
                `).join('');
            }

            // Inyectar Puntos
            if (dotsContainer) {
                dotsContainer.classList.toggle('hidden', modalImages.length <= 1);
                dotsContainer.innerHTML = modalImages.map((_, i) => `
                    <button type="button" class="modal-dot inline-flex items-center justify-center min-w-7 min-h-7 px-1 cursor-pointer" data-index="${i}" aria-label="Ver imagen ${i + 1} de ${modalImages.length}"><span class="modal-dot-pill h-2 rounded-full transition-all duration-300 shadow-sm ${i === 0 ? 'bg-accent-brown w-6' : 'bg-accent-brown/35 w-2'}"></span></button>
                `).join('');
                
                dotsContainer.querySelectorAll('.modal-dot').forEach(dot => {
                    dot.addEventListener('click', (ev) => {
                        ev.stopPropagation();
                        updateModalImage(parseInt(dot.getAttribute('data-index') || '0'));
                        startAutoplay(); // Reset timer
                    });
                });
            }

            const hasMultiple = modalImages.length > 1;
            lightboxControls?.classList.toggle('hidden', modalImages.length === 0);
            lightboxPrev?.classList.toggle('hidden', !hasMultiple);
            lightboxNext?.classList.toggle('hidden', !hasMultiple);
            lightboxSwipeHint?.classList.toggle('hidden', !hasMultiple);

            // Resetear imagen principal
            const mainImgEl = document.getElementById('modal-main-image') as HTMLImageElement;
            if (mainImgEl) {
                mainImgEl.src = modalImages[0] || 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
                mainImgEl.style.opacity = modalImages[0] ? '1' : '0';
                mainImgEl.style.transform = 'scale(1)';
            }

            modal.showModal();
            document.body.style.overflow = 'hidden';
            startAutoplay();
        });
    });

    modal.addEventListener('close', () => {
        document.body.style.overflow = '';
        stopAutoplay();
    });

    closeBtn.addEventListener('click', () => {
        modal.close();
        document.body.style.overflow = '';
        stopAutoplay();
    });

    modal.addEventListener('click', (e) => {
        if (e.target === modal) {
            modal.close();
            document.body.style.overflow = '';
            stopAutoplay();
        }
    });

    // Lightbox Controls
    document.getElementById('close-lightbox')?.addEventListener('click', () => {
        lightbox.close();
        startAutoplay();
    });

    document.getElementById('lightbox-next')?.addEventListener('click', (e) => {
        e.stopPropagation();
        updateLightboxImage((currentImgIndex + 1) % modalImages.length);
    });

    document.getElementById('lightbox-prev')?.addEventListener('click', (e) => {
        e.stopPropagation();
        updateLightboxImage((currentImgIndex - 1 + modalImages.length) % modalImages.length);
    });

    lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) {
            lightbox.close();
            startAutoplay();
        }
    });

    // Soporte de Swipe para el Lightbox
    addSwipeSupport(
        lightbox,
        () => {
            if (modalImages.length <= 1) return;
            updateLightboxImage((currentImgIndex + 1) % modalImages.length);
        },
        () => {
            if (modalImages.length <= 1) return;
            updateLightboxImage((currentImgIndex - 1 + modalImages.length) % modalImages.length);
        }
    );

    lightbox.addEventListener('cancel', () => {
        startAutoplay();
    });

    // Teclado para Lightbox
    document.addEventListener('keydown', (e) => {
        if (lightbox.open && modalImages.length > 0) {
            if (e.key === 'ArrowRight') updateLightboxImage((currentImgIndex + 1) % modalImages.length);
            if (e.key === 'ArrowLeft') updateLightboxImage((currentImgIndex - 1 + modalImages.length) % modalImages.length);
            if (e.key === 'Escape') {
                lightbox.close();
                startAutoplay();
            }
        }
    });
  }

  // Inicializar
  setupProjects();
  document.addEventListener('astro:after-swap', setupProjects);
</script>
