---
import { Icon } from "astro-icon/components";
import Doodle from './Doodle.astro';
import { ICON_OPTIONS, type CardIcon } from '../utils/icons';
import { toHTML } from '@portabletext/to-html';

interface Props {
  id: string;
  title: string;
  description: string;
  content?: any[];
  tags?: string[];
  icon?: string;
  link?: string;
  mainImage?: string;
  gallery?: string[];
}

const { 
  id,
  title, 
  description, 
  content,
  tags,
  icon,
  link = "#",
  mainImage = "",
  gallery 
} = Astro.props;

const byTitle: Record<string, CardIcon> = {
  thejudex: 'search',
  lumen: 'presentation',
  'tamara vasak': 'shop',
  synclife: 'blocks',
  pixdex: 'mobile',
};
const fallback = ICON_OPTIONS[[...title].reduce((n, c) => n + c.charCodeAt(0), 0) % ICON_OPTIONS.length].value;
const scene = (ICON_OPTIONS.some((o) => o.value === icon) ? icon : byTitle[title.toLowerCase()] ?? fallback) as CardIcon;
const safeContent = content || [];
const safeTags = tags || [];
const safeGallery = gallery || [];

const contentHtml = safeContent.length > 0 ? toHTML(safeContent) : description;
const projectData = JSON.stringify({ title, description, contentHtml, tags: safeTags, link, mainImage, gallery: safeGallery });
---

<div
  class="project-card fade-up group flex flex-col w-full md:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)] bg-main-bg border border-stroke/50 rounded-[32px] hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-accent-brown/5 hover:border-accent-brown/20 transition-[transform,border-color,box-shadow] duration-500 ease-out h-full cursor-pointer"
  data-project={projectData}
>
  <div class="flex flex-col flex-1 p-7 pt-6">
    <Doodle name={scene} class="h-28 w-auto mx-auto mb-4" />
    <div class="flex justify-between items-start mb-3">
      <h3 class="text-3xl font-medium tracking-wider text-accent-brown">{title}</h3>
      <div class="mt-1 text-accent-brown/60 group-hover:text-accent-brown group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-500 ease-out" aria-hidden="true">
        <Icon name="lucide:maximize-2" size={22} />
      </div>
    </div>

    <p class="text-lg leading-[150%] text-text-dark/85 mb-5 line-clamp-3 font-normal">
      {description}
    </p>

    <div class="mt-auto flex flex-col gap-3">
      {safeTags.length > 0 && (
        <ul class="flex flex-wrap gap-2 pb-2">
          {safeTags.slice(0, 2).map((tag) => (
            <li class="whitespace-nowrap text-sm px-4 py-1.5 rounded-full border border-stroke bg-white/30 text-text-dark tracking-wide font-medium">
              {tag}
            </li>
          ))}
          {safeTags.length > 2 && (
            <li class="whitespace-nowrap text-sm px-3 py-1.5 text-text-dark/80 font-medium">+{safeTags.length - 2}</li>
          )}
        </ul>
      )}

      <button class="flex items-center gap-2 text-sm font-semibold text-accent-brown tracking-[0.15em] uppercase group/btn" aria-label={`Ver detalles de ${title}`}>
        Ver detalles
        <span class="w-8 h-px bg-accent-brown/50 group-hover/btn:w-12 transition-all duration-300"></span>
      </button>
    </div>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .mask-linear-right {
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }

</style>
