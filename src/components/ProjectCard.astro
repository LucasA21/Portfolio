---
import Doodle from './Doodle.astro';
import { shotSrcset } from '../utils/sanity';
import { ICON_OPTIONS, type CardIcon } from '../utils/icons';
import { toHTML } from '@portabletext/to-html';

interface Props {
  id: string;
  title: string;
  description: string;
  content?: any[];
  tags?: string[];
  icon?: string;
  link?: string;
  mainImage?: string;
  gallery?: string[];
  screenshot?: string;
  screenshotAlt?: string;
}

const { 
  id,
  title, 
  description, 
  content,
  tags,
  icon,
  link = "#",
  mainImage = "",
  gallery,
  screenshot,
  screenshotAlt,
} = Astro.props;
const dev = import.meta.env.DEV;

const byTitle: Record<string, CardIcon> = {
  thejudex: 'search',
  lumen: 'presentation',
  'tamara vasak': 'shop',
  synclife: 'blocks',
  pixdex: 'mobile',
};
const fallback = ICON_OPTIONS[[...title].reduce((n, c) => n + c.charCodeAt(0), 0) % ICON_OPTIONS.length].value;
const scene = (ICON_OPTIONS.some((o) => o.value === icon) ? icon : byTitle[title.toLowerCase()] ?? fallback) as CardIcon;
const safeContent = content || [];
const safeTags = tags || [];
const safeGallery = gallery || [];

const contentHtml = safeContent.length > 0 ? toHTML(safeContent) : description;
const projectData = JSON.stringify({ title, description, contentHtml, tags: safeTags, link, mainImage, gallery: safeGallery });
---

<div
  class="project-card fade-up group relative flex flex-col w-full bg-main-bg border border-stroke/50 rounded-[28px] hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-accent-brown/5 hover:border-accent-brown/20 transition-[transform,border-color,box-shadow] duration-500 ease-out h-full cursor-pointer"
  data-project={projectData}
>
  <div class="flex flex-col flex-1 p-3 pb-5">
    <div class="rounded-2xl overflow-hidden border border-stroke/70 bg-wave-bg aspect-[16/10] flex items-center justify-center mb-4">
      {screenshot ? (
        <img src={screenshot} srcset={shotSrcset(screenshot)} sizes="(min-width: 1024px) 300px, (min-width: 768px) 45vw, calc(100vw - 72px)" alt={screenshotAlt ?? ''} class="w-full h-full object-cover object-top" loading="lazy" decoding="async" />
      ) : dev ? (
        <span class="text-[15px] text-text-dark/80">[captura]</span>
      ) : (
        <Doodle name={scene} class="h-20 w-auto" />
      )}
    </div>

    <div class="px-3 flex flex-col flex-1">
      <h3 class="text-2xl font-semibold tracking-wide text-accent-brown mb-1.5">{title}</h3>
      <p class="text-base leading-[150%] text-text-dark/90 mb-3 line-clamp-2">{description}</p>
      {safeTags.length > 0 && <p class="mt-auto text-[13px] tracking-wide text-text-dark/80">{safeTags.slice(0, 3).join(' · ')}</p>}
      <button type="button" class="absolute inset-0 rounded-[28px] cursor-pointer" aria-label={`Ver detalles de ${title}`}></button>
    </div>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .mask-linear-right {
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }

</style>
