---
import Doodle from './Doodle.astro';
import { shotSrcset } from '../utils/sanity';
import { ICON_OPTIONS, type CardIcon } from '../utils/icons';
import { toHTML } from '@portabletext/to-html';

interface Props {
  id: string;
  title: string;
  description: string;
  content?: any[];
  tags?: string[];
  icon?: string;
  link?: string;
  mainImage?: string;
  gallery?: string[];
  screenshot?: string;
  screenshotAlt?: string;
}

const { 
  id,
  title, 
  description, 
  content,
  tags,
  icon,
  link = "#",
  mainImage = "",
  gallery,
  screenshot,
  screenshotAlt,
} = Astro.props;

const byTitle: Record<string, CardIcon> = {
  thejudex: 'search',
  lumen: 'presentation',
  'tamara vasak': 'shop',
  synclife: 'blocks',
  levelme: 'mobile',
};
const fallback = ICON_OPTIONS[[...title].reduce((n, c) => n + c.charCodeAt(0), 0) % ICON_OPTIONS.length].value;
const scene = (ICON_OPTIONS.some((o) => o.value === icon) ? icon : byTitle[title.toLowerCase()] ?? fallback) as CardIcon;
const safeContent = content || [];
const safeTags = tags || [];
const safeGallery = gallery || [];
const liveUrl = link && /^https?:\/\//i.test(link) ? link : null;

const contentHtml = safeContent.length > 0 ? toHTML(safeContent) : description;
const projectData = JSON.stringify({ title, description, contentHtml, tags: safeTags, link, mainImage, gallery: safeGallery, screenshot });
---

<div
  class="project-card fade-up group relative flex flex-col w-full bg-main-bg border border-stroke/50 rounded-[28px] hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-accent-brown/5 transition-[transform,border-color,box-shadow] duration-500 ease-out h-full cursor-pointer"
  data-project={projectData}
>
  <div class="flex flex-col flex-1 p-3 pb-5">
    <div class="rounded-2xl overflow-hidden border border-stroke/70 bg-wave-bg aspect-[16/10] flex items-center justify-center mb-4">
      {screenshot ? (
        <img src={screenshot} srcset={shotSrcset(screenshot)} sizes="(min-width: 1024px) 340px, (min-width: 768px) 45vw, calc(100vw - 72px)" alt={screenshotAlt ?? ''} class="w-full h-full object-cover object-top" loading="lazy" decoding="async" />
      ) : (
        <Doodle name={scene} class="h-20 w-auto" />
      )}
    </div>

    <div class="px-3 flex flex-col flex-1">
      <h3 class="text-2xl font-semibold tracking-wide text-accent-brown mb-1.5">{title}</h3>
      <p class="text-base leading-[150%] text-text-dark/90 mb-3 line-clamp-3">{description}</p>
      {safeTags.length > 0 && <p class="mt-auto text-sm tracking-wide text-text-dark/80">{safeTags.slice(0, 3).join(' · ')}</p>}
      <button type="button" class="absolute inset-0 rounded-[28px] cursor-pointer" aria-label={`Ver caso: ${title}`}></button>
      <div class="mt-3 flex items-center justify-between gap-4">
        <span class="text-sm font-medium text-accent-brown group-hover:underline underline-offset-4" aria-hidden="true">Ver caso</span>
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 inline-flex items-center gap-1 min-h-11 px-3 -mx-3 -my-2 text-sm font-medium text-accent-brown hover:underline underline-offset-4 decoration-accent-brown/60 transition-colors"
          >
            Ver sitio
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .mask-linear-right {
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }

</style>
