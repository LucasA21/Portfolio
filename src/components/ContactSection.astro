---
import ContactScene from './scenes/ContactScene.astro';

interface ContactData {
  tagline: string;
  description: string;
  email: string;
  ctaLabel: string;
}

interface Props {
  contact: ContactData;
  linkedin?: string;
}

const { contact, linkedin } = Astro.props;

---

<section id="contact" class="fade-up-bottom flex flex-col md:flex-row justify-between bg-main-bg border border-stroke/50 rounded-[40px] pt-6 md:pt-8 px-6 sm:px-10 pb-0 lg:pt-12 lg:px-16 lg:pb-0 gap-2 md:gap-8 mt-6 md:mt-0 relative scroll-mt-[22vh] overflow-hidden">
  
  <div class="flex flex-col flex-1 z-10 w-full items-center md:items-start justify-center self-center pt-8 pb-4 md:py-4 md:mb-8 lg:mb-12">
    <div class="flex flex-col items-center md:items-start text-center md:text-left gap-4 max-w-lg">
      
      <h2 class="text-accent-brown text-3xl md:text-4xl font-medium tracking-wider mb-2">{contact.tagline}</h2>
      
      <p class="text-lg text-text-dark/90 leading-relaxed mb-4">
        {contact.description}
      </p>
  
      <a href={`mailto:${contact.email}`} class="mail-link relative inline-flex items-center min-h-11 text-[clamp(1rem,5vw,40px)] font-medium tracking-wide text-accent-brown break-all md:break-normal">
        {contact.email}
      </a>

      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mt-2">
        <button type="button" data-copy-mail={contact.email} class="inline-flex items-center min-h-11 bg-accent-brown text-main-bg px-8 py-3 rounded-full text-sm font-medium tracking-widest active:scale-95 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 cursor-pointer">
          Copiar mail
        </button>
        {linkedin && (
          <a href={linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 border border-accent-brown/40 text-accent-brown px-8 py-3 rounded-full text-sm font-medium tracking-widest hover:shadow-lg hover:-translate-y-0.5 active:scale-95 transition-all duration-300">LinkedIn</a>
        )}
        <span class="font-hand text-accent-warm text-lg" role="status" aria-live="polite" data-copy-status></span>
      </div>
    </div>
  </div>

  <div class="shrink-0 w-[90%] sm:w-[60%] md:w-1/2 lg:w-[40%] flex justify-center md:justify-end z-10 self-center md:self-end md:-mr-8 lg:-mr-12 -mt-4 md:mt-0">
    <!-- Imagen para Desktop -->
    <div class="hidden md:block w-full max-w-[380px]"><ContactScene variant="desktop" class="w-full h-auto block" /></div>
    <!-- Imagen para Mobile -->
    <div class="block md:hidden w-full max-w-[320px]"><ContactScene variant="mobile" class="w-full h-auto block" /></div>
  </div>

</section>


<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-mail]').forEach((btn) => {
    const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    let t: number | undefined;
    btn.addEventListener('click', async () => {
      let ok = false;
      try {
        await navigator.clipboard.writeText(btn.dataset.copyMail!);
        ok = true;
      } catch {}
      if (status) status.textContent = ok ? 'Copiado' : 'No se pudo copiar, usá el link del mail';
      clearTimeout(t);
      t = window.setTimeout(() => status && (status.textContent = ''), 2500);
    });
  });
</script>
