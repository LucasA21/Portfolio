---
import HeroFrames from './scenes/HeroFrames.astro';

interface Props {
  greeting: string;
  title: string;
  subtitle: string;
  lead: string;
  ctaLabel: string;
  secondaryLabel: string;
}

const { greeting, title, subtitle, lead, ctaLabel, secondaryLabel } = Astro.props;

---

<section class="flex flex-col md:flex-row items-center md:items-center justify-between gap-8 lg:gap-16 mt-6 md:mt-12 pb-12 md:pb-0 scroll-mt-[22vh]">
  
  <div class="flex-1 w-full text-center md:text-left px-2 sm:px-6 md:pl-0 lg:pl-8 hero-animate-2 flex flex-col items-center md:items-start justify-center">
    
    <p class="font-hand text-accent-warm text-xl mb-2">{greeting}</p>

    <h1 data-split class="text-[clamp(2.2rem,7vw,2.75rem)] leading-[120%] md:leading-[130%] tracking-normal md:tracking-wider font-normal max-w-[800px] text-balance">
      <span class="font-semibold text-accent-brown">{title}</span><br />
      {subtitle}
    </h1>

    <p class="mt-5 md:mt-6 text-lg leading-[160%] text-text-dark/90 max-w-[46ch] text-pretty">{lead}</p>

    <!-- Botones CTA: arriba de la ilustración en mobile, junto al texto en desktop -->
    <div class="flex gap-2.5 md:gap-3 mt-7 md:mt-14 relative z-10 w-full justify-center md:justify-start">
      <a href="#projects" class="btn-projects flex-1 md:flex-none h-12 md:h-auto inline-flex justify-center bg-accent-brown text-main-bg px-3 sm:px-5 lg:px-8 md:py-3.5 rounded-full text-[15px] md:text-base font-medium whitespace-nowrap hover:shadow-lg transition-all items-center gap-2 md:gap-2.5 cursor-pointer group active:scale-95">
        {ctaLabel}
        <svg aria-hidden="true" class="btn-projects-arrow w-4 h-4 md:w-5 md:h-5 group-hover:translate-x-1.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </a>
      <a href="#contact" class="flex-1 md:flex-none h-12 md:h-auto inline-flex justify-center bg-glass-card border border-accent-brown/60 text-accent-brown px-3 sm:px-5 lg:px-8 md:py-3.5 rounded-full text-[15px] md:text-base font-medium whitespace-nowrap items-center hover:shadow-lg hover:-translate-y-0.5 transition-all active:scale-95">{secondaryLabel}</a>
    </div>
  </div>

  <!-- Ilustración -->
  <div class="shrink-0 flex justify-center md:justify-end hero-animate-3 w-full md:w-auto -mt-2 md:mt-0">
    <div class="w-64 md:w-80 lg:w-[420px]"><HeroFrames class="w-full h-auto block overflow-visible" /></div>
  </div>

</section>

