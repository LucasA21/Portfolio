---
export interface SocialLink {
  _key: string;
  platform: string;
  url: string;
}

interface Props {
  socialLinks?: SocialLink[];
  label?: string;
  variant?: 'inline' | 'circle';
  class?: string;
}

const {
  socialLinks = [],
  label = 'Redes',
  variant = 'inline',
  class: className = '',
} = Astro.props;

const labels: Record<string, string> = {
  linkedin: 'LinkedIn',
  gmail: 'Email',
  instagram: 'Instagram',
  github: 'GitHub',
  twitter: 'X',
};

const iconSize = variant === 'circle' ? 22 : 20;
const itemClass =
  variant === 'circle'
    ? 'inline-flex items-center justify-center size-[52px] rounded-full border border-accent-brown/25 text-accent-brown hover:border-accent-brown/60 transition-colors'
    : 'inline-flex items-center justify-center size-11 text-accent-brown hover:-translate-y-1 hover:opacity-70 transition-all';
---

<nav aria-label={label} class:list={['flex items-center', variant === 'circle' ? 'gap-3' : 'gap-0 sm:gap-2', className]}>
  {socialLinks.map((social) => {
    const isMail = social.url.startsWith('mailto:');
    const ariaLabel = labels[social.platform] ?? social.platform;
    return (
      <a
        href={social.url}
        target={isMail ? undefined : '_blank'}
        rel={isMail ? undefined : 'noopener noreferrer'}
        class={itemClass}
        aria-label={ariaLabel}
      >
        <svg
          width={iconSize}
          height={iconSize}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          {social.platform === 'linkedin' && (
            <>
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect x="2" y="9" width="4" height="12" />
              <circle cx="4" cy="4" r="2" />
            </>
          )}
          {social.platform === 'gmail' && (
            <>
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-9 5.7a2 2 0 0 1-2 0L2 7" />
            </>
          )}
          {social.platform === 'instagram' && (
            <>
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </>
          )}
          {social.platform === 'github' && (
            <>
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </>
          )}
          {social.platform === 'twitter' && (
            <path d="M4 4l11.7 16h4.3L8.3 4H4zm0 16 6.8-7.4M13.2 11.4 20 4" />
          )}
          {!(social.platform in labels) && (
            <>
              <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
              <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
            </>
          )}
        </svg>
      </a>
    );
  })}
</nav>
