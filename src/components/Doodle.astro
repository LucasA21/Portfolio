      { d: rr(112, 234, 26, 18, 3), body: true, a: 'sway' },
      { d: 'M112 239H103M112 247H103', a: 'sway' },
      { d: 'M138 243C148 243 152 247 160 246', a: 'sway' },
      { d: 'M290 214H326V238Q326 252 312 252H304Q290 252 290 238Z', body: true },
      { d: 'M326 222C342 222 342 244 326 244' },
      { d: 'M300 202C294 194 306 190 300 180', a: 'steam' },
      { d: 'M314 202C308 194 320 190 314 180', a: 'steam' },
    ],
