---
// Line-icon battery in the portfolio's hand-drawn language: thin even strokes, rounded
// corners, an inset highlight line and a solid side shadow (like the mailbox drawing).
// Every stroke has pathLength="1" so `.line-draw` (global.css) draws it in on scroll.
import type { IconName } from '../utils/icons';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = '' } = Astro.props;

const INK = '#531F1F';
const BG = '#F6F5F1';

const rr = (x: number, y: number, w: number, h: number, r = 6) =>
  `M${x + r} ${y}H${x + w - r}A${r} ${r} 0 0 1 ${x + w} ${y + r}V${y + h - r}A${r} ${r} 0 0 1 ${x + w - r} ${y + h}H${x + r}A${r} ${r} 0 0 1 ${x} ${y + h - r}V${y + r}A${r} ${r} 0 0 1 ${x + r} ${y}Z`;
const circ = (cx: number, cy: number, r: number) =>
  `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0Z`;
const dot = (x: number, y: number) => `M${x} ${y}h0.01`;
const spark = (x: number, y: number, s: number) =>
  `M${x} ${y - s}C${x + s * 0.12} ${y - s * 0.3} ${x + s * 0.3} ${y - s * 0.12} ${x + s} ${y}C${x + s * 0.3} ${y + s * 0.12} ${x + s * 0.12} ${y + s * 0.3} ${x} ${y + s}C${x - s * 0.12} ${y + s * 0.3} ${x - s * 0.3} ${y + s * 0.12} ${x - s} ${y}C${x - s * 0.3} ${y - s * 0.12} ${x - s * 0.12} ${y - s * 0.3} ${x} ${y - s}Z`;

// body: filled with bg (hides its shadow). shadow: also drawn as a solid ink copy shifted right.
// ink: solid accent. w: stroke width override. a: animation class.
type Item = { d: string; body?: boolean; shadow?: boolean; ink?: boolean; w?: number; a?: string };

const SH = 6; // side shadow offset

