};

const icon = icons[name];
const sw = name === 'notfound' ? 3 : 2.2;
---

<svg viewBox={icon.vb} class={`${className}`} fill="none" stroke={INK} stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <g class="icon-ink">
    {icon.items.filter((i) => i.shadow).map((i) => <path d={i.d} fill={INK} stroke="none" transform={`translate(${name === 'notfound' ? 10 : SH} 0)`} />)}
  </g>
  <g class="line-draw">
    {icon.items.map((i) =>
      i.ink && !i.w ? (
        <path d={i.d} fill={INK} stroke="none" class={i.a} />
      ) : (
        <path pathLength="1" d={i.d} fill={i.body ? BG : 'none'} stroke={INK} stroke-width={i.w} class={i.a} />
      )
    )}
  </g>
</svg>
