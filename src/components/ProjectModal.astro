<dialog id="project-modal" class="bg-transparent border-none p-0 m-0 w-full h-full max-w-full max-h-full backdrop:bg-black/60 backdrop:backdrop-blur-md group overflow-hidden">
  <div class="fixed inset-0 flex items-center justify-center p-0 md:p-8 z-50">
    <!-- Modal Container -->
    <div 
      id="modal-content"
      class="bg-main-bg w-full h-full md:h-[90vh] md:max-w-4xl md:max-h-[850px] md:rounded-[40px] shadow-2xl relative flex flex-col overflow-hidden project-modal-animate"
    >
      <!-- Close Button -->
      <button 
        id="close-modal"
        type="button"
        class="absolute top-5 right-5 z-40 size-11 inline-flex items-center justify-center bg-main-bg/95 hover:bg-main-bg text-accent-brown rounded-full transition-all cursor-pointer group/close shadow-md border border-accent-brown/25"
        aria-label="Cerrar modal"
      >
        <svg class="w-5 h-5 transition-transform group-hover/close:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>

      <!-- Top: Carousel -->
      <div id="modal-carousel-wrap" class="w-full h-[30%] md:h-[40%] relative group/carousel bg-wave-bg shrink-0 cursor-zoom-in border-b border-stroke/60">
        <!-- Main Image -->
        <div id="modal-image-container" role="button" tabindex="0" aria-label="Ampliar imagen del proyecto" class="w-full h-full relative overflow-hidden bg-wave-bg focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-accent-brown">
            <img 
                id="modal-main-image" 
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" 
                alt="Imagen del proyecto (clic para ampliar)" 
                class="absolute inset-0 w-full h-full object-cover object-top transition-all duration-700 ease-in-out scale-100 hover:scale-105" 
            />
            <!-- Visual Hint for Lightbox -->
            <div class="absolute bottom-4 right-4 z-20 flex items-center gap-2 px-3 py-1.5 bg-main-bg/90 backdrop-blur-md rounded-full border border-accent-brown/20 text-accent-brown pointer-events-none transition-all group-hover/carousel:bg-main-bg group-hover/carousel:scale-105 shadow-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
                </svg>
                <span class="text-xs font-medium tracking-wide hidden md:block">Clic para ampliar</span>
            </div>
        </div>

        <!-- Carousel Dots Indicator -->
        <div id="modal-dots-container" class="absolute bottom-2 inset-x-0 flex justify-center gap-1 z-30">
            <!-- Dots injected here -->
        </div>
      </div>

      <!-- Lightbox (Full Screen Gallery) -->
      <dialog 
        id="project-lightbox" 
        class="fixed inset-0 w-full h-dvh bg-transparent text-white border-none p-0 m-0 z-100 backdrop:bg-black/95 backdrop:backdrop-blur-2xl max-w-none max-h-none overflow-hidden"
      >
        <div class="w-full h-full flex flex-col justify-between p-4 sm:p-6 lg:p-10">
          <!-- Top Bar -->
          <div class="flex justify-end shrink-0">
            <button id="close-lightbox" type="button" class="size-12 inline-flex items-center justify-center bg-black/60 hover:bg-white/20 text-white rounded-full backdrop-blur-xl border border-white/25 transition-all active:scale-90 shadow-xl cursor-pointer" aria-label="Cerrar vista ampliada">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg>
            </button>
          </div>

          <!-- Center Image -->
          <div class="flex-1 min-h-0 flex items-center justify-center py-3 pointer-events-none">
            <img 
              id="lightbox-image" 
              src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" 
              alt="Vista ampliada" 
              class="max-w-full max-h-full lg:max-w-6xl object-contain rounded-lg shadow-2xl transition-all duration-300" 
            />
          </div>

          <!-- Bottom Controls -->
          <div class="flex flex-col items-center gap-2 shrink-0">
            <div id="lightbox-controls" class="flex items-center justify-center gap-4">
              <button id="lightbox-prev" type="button" class="size-11 sm:size-12 inline-flex items-center justify-center bg-black/60 hover:bg-white/20 text-white rounded-full backdrop-blur-xl border border-white/25 transition-all active:scale-90 cursor-pointer" aria-label="Imagen anterior">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
              </button>
              <div id="lightbox-counter" class="px-5 py-2 bg-black/75 backdrop-blur-xl rounded-full text-white font-medium text-xs border border-white/20 shadow-xl">
                1 / 1
              </div>
              <button id="lightbox-next" type="button" class="size-11 sm:size-12 inline-flex items-center justify-center bg-black/60 hover:bg-white/20 text-white rounded-full backdrop-blur-xl border border-white/25 transition-all active:scale-90 cursor-pointer" aria-label="Imagen siguiente">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l6 6-6 6"/></svg>
              </button>
            </div>
            <span id="lightbox-swipe-hint" class="lg:hidden text-xs font-medium text-white/80 tracking-wide">Deslizá o usá las flechas</span>
          </div>
        </div>
      </dialog>

      <!-- Bottom: Details -->
      <div class="flex-1 flex flex-col min-h-0 bg-main-bg relative md:rounded-r-[40px]">
        <div id="modal-details-scroll" class="flex-1 overflow-y-auto no-scrollbar px-8 md:px-16 pt-8 pb-28">
            <div class="mb-8">
                <div id="modal-tags" class="flex flex-wrap gap-2 mb-4"></div>
                <h2 id="modal-title" class="text-3xl md:text-5xl font-medium text-accent-brown tracking-tighter mb-4 leading-tight">
                    <span class="sr-only">Detalles del proyecto</span>
                </h2>
                <p id="modal-lead" class="text-lg md:text-xl leading-[160%] text-text-dark/90 text-pretty max-w-3xl"></p>
            </div>

            <div class="max-w-3xl">
                <h3 class="text-xs font-bold tracking-[0.22em] text-accent-brown/80 uppercase mb-4 flex items-center gap-4">
                    Sobre el proyecto
                    <span class="h-px grow bg-accent-brown/20"></span>
                </h3>
                <div id="modal-description" class="rich-text text-base md:text-lg leading-[170%] text-text-dark/90 font-normal text-pretty pr-4"></div>
            </div>
        </div>

        <!-- Sticky Footer for Link -->
        <div id="modal-link-wrap" class="absolute bottom-0 inset-x-0 p-6 md:p-8 md:px-16 bg-linear-to-t from-main-bg via-main-bg/90 to-transparent z-20 md:rounded-br-[40px]">
            <a 
                id="modal-link" 
                href="#" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 w-full min-h-12 bg-accent-brown text-main-bg py-3.5 rounded-full font-medium hover:bg-accent-brown/90 transition-all tracking-wider text-base active:scale-[0.98] shadow-lg shadow-accent-brown/10"
            >
                Ver sitio
            </a>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style is:global>
  #project-modal[open] {
    display: block;
  }
  
  .project-modal-animate {
    animation: modal-in 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes modal-in {
    from { opacity: 0; transform: translateY(40px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .rich-text p {
    margin-bottom: 1.5rem;
  }
  .rich-text p:last-child {
    margin-bottom: 0;
  }
  .rich-text ul {
    list-style-type: disc;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .rich-text ol {
    list-style-type: decimal;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .rich-text li {
    margin-bottom: 0.5rem;
  }
  .rich-text li::marker {
    color: #531F1F;
    font-weight: bold;
  }
  .rich-text strong, .rich-text b {
    font-weight: 700 !important;
    color: #531F1F !important;
    opacity: 1 !important;
  }

  @keyframes swipe-hint {
    0%, 100% { opacity: 0.3; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-8px); }
  }

  @keyframes swipe-bar {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(0%); }
    100% { transform: translateX(100%); }
  }

  @keyframes swipe-arrow-left {
    0%, 100% { transform: translateX(0); opacity: 0.2; }
    50% { transform: translateX(-4px); opacity: 1; }
  }

  @keyframes swipe-arrow-right {
    0%, 100% { transform: translateX(0); opacity: 0.2; }
    50% { transform: translateX(4px); opacity: 1; }
  }

  .animate-swipe-hint {
    animation: swipe-hint 3s ease-in-out infinite;
  }

  .animate-swipe-bar {
    animation: swipe-bar 2s ease-in-out infinite;
  }

  .animate-swipe-left {
    animation: swipe-arrow-left 2s ease-in-out infinite;
  }

  .animate-swipe-right {
    animation: swipe-arrow-right 2s ease-in-out infinite;
  }
</style>
