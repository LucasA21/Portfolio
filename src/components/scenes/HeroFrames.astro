---
// Hero drawn by hand in Krita: one <g data-piece> per piece, one <g data-frame> per drawing (generated by
// scripts/illustrations/hero-frames/trace.mjs). src/scripts/motion/hero-frames.ts swaps which frame is visible.
import raw from './hero-frames.svg?raw';
interface Props { class?: string; scene?: string; box?: string }
const { class: className = '', scene = 'hero', box = '270 280 2560 2520' } = Astro.props;
// Route of the hero stretch: starts at the fingertips of the release frame, then glides down the right margin.
const route = 'M2110 520C2400 470 2690 620 2710 1000C2730 1500 2660 1950 2690 2800';
---
<svg data-scene={scene} data-frames viewBox={box} class={className} role="img" aria-label="Lucas programando en su escritorio con una laptop y un monitor">
  <g set:html={raw} />
  <path data-thread-path="hero" fill="none" stroke="none" d={route} />
</svg>
