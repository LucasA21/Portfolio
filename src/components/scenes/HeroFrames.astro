---
// Hero drawn by hand in Krita: one <g data-piece> per piece, one <g data-frame> per drawing (generated by
// scripts/illustrations/hero-frames/trace.mjs). src/scripts/motion/hero-frames.ts swaps which frame is visible.
import raw from './hero-frames.svg?raw';
interface Props { class?: string; scene?: string; box?: string }
const { class: className = '', scene = 'hero', box = '270 280 2560 2520' } = Astro.props;
// Route of the hero stretch: starts in the open hand of the release frame (tail on the palm, nose past the fingers),
// leaves forward and slightly up like a real throw, then glides down the right margin.
const route = 'M2190 560C2520 380 2900 460 2960 900C3000 1420 2900 1950 2950 2800';
---
<svg data-scene={scene} data-frames viewBox={box} class={className} role="img" aria-label="Lucas en su escritorio; al bajar, tira un avión de papel que recorre la página">
  <g set:html={raw} />
  <path data-thread-path="hero" fill="none" stroke="none" d={route} />
</svg>
