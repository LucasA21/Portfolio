---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro"
import SpeedInsights from "@vercel/speed-insights/astro"
import font400 from "@fontsource/halant/files/halant-latin-400-normal.woff2?url";
import font500 from "@fontsource/halant/files/halant-latin-500-normal.woff2?url";
import font600 from "@fontsource/halant/files/halant-latin-600-normal.woff2?url";
import font700 from "@fontsource/halant/files/halant-latin-700-normal.woff2?url";
import { SIGNATURE_VARIANT } from "../config/site";
import { buildPortfolioGraph, safeJsonLdStringify } from "../utils/seo";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { 
  title, 
  description = "Programador fullstack con foco en frontend y UI/UX. Interfaces claras, rápidas y productos web completos en Astro, React y TypeScript.",
  noindex = false,
  jsonLd,
} = Astro.props;

const baseTitle = "Lucas Araya | Fullstack Developer";
const optimizedTitle = title === "Home" || !title || title.includes("Lucas Araya") 
  ? baseTitle 
  : `${title} | ${baseTitle}`;

const canonicalURL = new URL(Astro.url.pathname, "https://lucasaraya.com.ar");
const socialImageURL = new URL("/og-image.png", "https://lucasaraya.com.ar");
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";
const structuredData =
  jsonLd ?? buildPortfolioGraph({}, [], "https://lucasaraya.com.ar", description);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add("js-motion");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Preload Critical Fonts -->
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font700} as="font" type="font/woff2" crossorigin />
    {SIGNATURE_VARIANT === 'marker' && (
      <>
        <link rel="preload" href="/fonts/reenie-beanie-lucas.woff2" as="font" type="font/woff2" crossorigin />
        <style is:inline>
          @font-face {
            font-family: 'Reenie Beanie';
            font-style: normal;
            font-weight: 400;
            font-display: swap;
            src: url(/fonts/reenie-beanie-lucas.woff2) format('woff2');
          }
        </style>
      </>
    )}
    
    <title>{optimizedTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Lucas Araya" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#F6F5F1" />
    <meta name="robots" content={robotsContent} />
    
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Lucas Araya | Fullstack Developer" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={optimizedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lucas Araya, Fullstack Developer especializado en UI/UX" />

    {!noindex && (
      <script is:inline type="application/ld+json" set:html={safeJsonLdStringify(structuredData)} />
    )}

    <!-- Twitter (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={optimizedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />


    <style is:global>
      @keyframes fade-in {
        from { transform: translateY(10px); }
        to { transform: translateY(0); }
      }
      .hero-animate-1 { animation: fade-in 0.6s ease-out forwards; }
      .hero-animate-2 { animation: fade-in 0.6s ease-out 0.1s forwards; }
      .hero-animate-3 { animation: fade-in 0.6s ease-out 0.2s forwards; }

      @media (max-width: 768px) {
        .hero-animate-1, .hero-animate-2, .hero-animate-3 {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
        }
      }
    </style>
  </head>
  <body id="top">
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <main id="main-content" tabindex="-1" class="w-full overflow-x-clip relative focus:outline-none">
      <slot />
    </main>
    <script>
      import "../scripts/motion/index";
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
